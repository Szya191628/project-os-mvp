{
  "name": "project-os-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:dev": "tsx server/src/main.ts",
    "api:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "test:oa": "tsx --test tests/approvalRecipients.test.ts tests/approvalPolicyRoutes.test.ts tests/approvalNotification.test.ts tests/notificationRoute.test.ts tests/approvalOverdueRule.test.ts",
    "test:claim-tasks": "tsx --test tests/claimTaskDepartments.test.ts",
    "test:published-tasks": "tsx --test tests/publishedTasks.test.ts",
    "test:wechat": "tsx --test tests/wechatAuth.test.ts",
    "test:all": "pnpm test && pnpm test:oa && pnpm test:claim-tasks && pnpm test:published-tasks && pnpm test:wechat",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:validate": "prisma validate --schema server/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed": "tsx server/prisma/seed.ts",
    "test": "node --experimental-strip-types --test tests/workflow.test.ts tests/canvas.test.ts tests/agent.test.ts tests/http.test.ts tests/auth.test.ts tests/dingtalkBot.test.ts tests/dingtalkConfig.test.ts tests/taskRelease.test.ts tests/taskMenu.test.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@prisma/client": "6.19.3",
    "dingtalk-stream": "2.1.5",
    "dotenv": "16.6.1",
    "fastify": "5.12.1",
    "lucide-react": "1.34.0",
    "pinyin-pro": "^3.29.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.1.5"
  }
}
