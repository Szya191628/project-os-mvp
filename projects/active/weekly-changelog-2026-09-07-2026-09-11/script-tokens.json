        "本周，",
        { "display": "Project OS", "spoken": "项目系统" },
        "打通钉钉任务交付闭环。"
      ]
    },
    {
      "id": "l2",
      "tokens": [
        "权限统一到项目级。",
        { "display": "L3", "spoken": "L 3" },
        "只执行自己的任务；直属主管能查看，但不能编辑或审批。"
      ]
    },
    {
      "id": "l3",
      "tokens": [
        "交付分为阶段和最终。",
        { "display": "L3", "spoken": "L 3" },
        "可在钉钉多次提交进度和附件，结果实时同步。"
      ]
    },
    {
      "id": "l4",
      "tokens": [
        "最终交付由",
        { "display": "L2", "spoken": "L 2" },
        "和管理员审批。全部通过后，任务才完成，并启动下游任务。"
      ]
    },
    {
      "id": "l5",
      "tokens": [
        "任务完成后系统重算排期，开始前三天预警；超期完成还要填写原因。"
      ]
    },
    {
      "id": "l6",
      "tokens": [
        "计划、执行、交付和通知，形成一条可追踪的闭环。"
      ]
    }
  ]
