DATABASE_URL=postgresql://project_os:project_os_dev@127.0.0.1:54329/project_os?schema=public
HOST=127.0.0.1
PORT=8787
PUBLIC_API_ORIGIN=http://127.0.0.1:8787
FRONTEND_ORIGIN=http://127.0.0.1:5173
DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
DEFAULT_MEMBER_ID=00000000-0000-0000-0000-000000000101
ALLOW_DEV_MEMBER_HEADER=true
COOKIE_SECURE=false
SESSION_COOKIE_NAME=project_os_session
SESSION_TTL_SECONDS=28800
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_ORGANIZATION_ID=
DINGTALK_REDIRECT_URI=http://127.0.0.1:8787/api/v1/auth/dingtalk/callback
DINGTALK_SCOPE=openid
DINGTALK_AUTHORIZATION_URL=https://login.dingtalk.com/oauth2/auth
DINGTALK_TOKEN_URL=https://api.dingtalk.com/v1.0/oauth2/userAccessToken
DINGTALK_USER_INFO_URL=https://api.dingtalk.com/v1.0/contact/users/me
DINGTALK_USER_DETAILS_URL=https://oapi.dingtalk.com/topapi/v2/user/get
DINGTALK_DEPARTMENT_DETAILS_URL=https://oapi.dingtalk.com/topapi/v2/department/get
DINGTALK_DEPARTMENT_LIST_IDS_URL=https://oapi.dingtalk.com/topapi/v2/department/listsubid
DINGTALK_DEPARTMENT_USERS_URL=https://oapi.dingtalk.com/topapi/v2/user/list
DINGTALK_ROOT_DEPARTMENT_ID=1
DINGTALK_REQUEST_TIMEOUT_MS=8000
# ---- 微信小程序登录（code2session 换取 openid）----
# 小程序 AppID / AppSecret；AppSecret 属敏感信息，切勿提交到版本库或写入日志
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_SECRET=
# 微信身份归属的组织；缺省回退 DEFAULT_ORGANIZATION_ID
WECHAT_MINIPROGRAM_ORGANIZATION_ID=
# code2session 接口地址与超时；一般无需修改
WECHAT_MINIPROGRAM_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_MINIPROGRAM_REQUEST_TIMEOUT_MS=8000
# ---- 微信账号绑定码（Web 端签发、小程序端输入，把 openid 绑定到成员）----
# 绑定码有效期（毫秒）；默认 600000 = 10 分钟
WECHAT_BIND_CODE_TTL_MS=600000
# 同一 openid 在时间窗内的失败尝试上限（防暴力猜测）；默认 5
WECHAT_BIND_CODE_MAX_ATTEMPTS=5
# 失败尝试统计的时间窗（毫秒）；默认 600000 = 10 分钟
WECHAT_BIND_CODE_ATTEMPT_WINDOW_MS=600000
# 未绑定登录签发的短时绑定令牌的 HMAC 签名密钥；缺省回退 AppSecret（生产建议单独配置）
WECHAT_BIND_TOKEN_SECRET=
# 绑定令牌有效期（毫秒）；默认 600000 = 10 分钟
WECHAT_BIND_TOKEN_TTL_MS=600000
# ---- 钉钉 OA 审批集成（任务交付物走审批流）----
# 审批模板 processCode（OA 管理后台 → 审批模板管理 → 模板 Code）
DINGTALK_APPROVAL_PROCESS_CODE=
# 审批表单中"交付物附件"控件的名称，用于提取附件
DINGTALK_APPROVAL_ATTACHMENT_FIELD=交付物附件
# 事件订阅回调凭据（钉钉开放平台 → 事件订阅）；未配置时用 worker 轮询兜底
DINGTALK_CALLBACK_TOKEN=
DINGTALK_CALLBACK_AES_KEY=
DINGTALK_CALLBACK_ENABLED=true
# 轮询兜底：每轮检查 PENDING 审批实例的数量与开关
DINGTALK_APPROVAL_POLL_ENABLED=true
DINGTALK_APPROVAL_POLL_BATCH_SIZE=10
DELIVERABLE_STORAGE_DIR=server/uploads/deliverables
DELIVERABLE_MAX_SIZE_BYTES=52428800

# 钉钉 OA 审批集成（交付物审批 → 自动完成任务）
# 审批模板 processCode（钉钉后台"工作流模板读权限"里通过 /v1.0/workflow/processSchemas 获取）
DINGTALK_APPROVAL_PROCESS_CODE=
# 审批表单中附件控件的名称
DINGTALK_APPROVAL_ATTACHMENT_FIELD=交付物附件
# 轮询兜底（本地开发收不到事件回调时依赖轮询）
DINGTALK_APPROVAL_POLL_ENABLED=true
DINGTALK_APPROVAL_POLL_BATCH_SIZE=10
# 事件订阅（审批状态回调，生产环境建议开启）
DINGTALK_CALLBACK_ENABLED=true
DINGTALK_CALLBACK_TOKEN=
DINGTALK_CALLBACK_AES_KEY=
# ---- 外部实例补偿发现（文档 §8）：主动扫描模板近期实例补建本地审批记录 ----
DINGTALK_APPROVAL_DISCOVERY_ENABLED=true
DINGTALK_APPROVAL_DISCOVERY_WINDOW_MS=86400000
# ---- 交付物安全查看链接（文档 §6.3）：签名密钥与有效期；不配则回退钉钉 AppSecret ----
DELIVERABLE_VIEW_SECRET=
DELIVERABLE_VIEW_TTL_MS=604800000
