# ---- 微信小程序登录（code2session 换取 openid）----
# 小程序 AppID / AppSecret；AppSecret 属敏感信息，切勿提交到版本库或写入日志
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_SECRET=
# 微信身份归属的组织；缺省回退 DEFAULT_ORGANIZATION_ID
WECHAT_MINIPROGRAM_ORGANIZATION_ID=
# code2session 接口地址与超时；一般无需修改
WECHAT_MINIPROGRAM_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_MINIPROGRAM_REQUEST_TIMEOUT_MS=8000
# ---- 微信账号绑定码（Web 端签发、小程序端输入，把 openid 绑定到成员）----
# 绑定码有效期（毫秒）；默认 600000 = 10 分钟
WECHAT_BIND_CODE_TTL_MS=600000
# 同一 openid 在时间窗内的失败尝试上限（防暴力猜测）；默认 5
WECHAT_BIND_CODE_MAX_ATTEMPTS=5
# 失败尝试统计的时间窗（毫秒）；默认 600000 = 10 分钟
WECHAT_BIND_CODE_ATTEMPT_WINDOW_MS=600000
# 未绑定登录签发的短时绑定令牌的 HMAC 签名密钥；缺省回退 AppSecret（生产建议单独配置）
WECHAT_BIND_TOKEN_SECRET=
# 绑定令牌有效期（毫秒）；默认 600000 = 10 分钟
WECHAT_BIND_TOKEN_TTL_MS=600000
DINGTALK_API_BUDGET_ENABLED=true
DINGTALK_API_MONTHLY_LIMIT=5000
DINGTALK_API_MONTHLY_RESERVE=500
DINGTALK_APPROVAL_DOWNLOAD_ATTACHMENTS_ON_APPROVAL=false
# 群机器人（Stream 模式）。默认复用上面的企业内部应用凭证；如使用独立机器人应用，可单独填写 BOT_CLIENT_ID/SECRET。
DINGTALK_BOT_ENABLED=false
DINGTALK_BOT_MODE=stream
DINGTALK_BOT_CLIENT_ID=
DINGTALK_BOT_CLIENT_SECRET=
DINGTALK_BOT_REQUIRE_MENTION=true
DINGTALK_BOT_PROACTIVE_ENABLED=true
DINGTALK_BOT_DEBUG=false
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_MAX_ATTEMPTS=3
PI_AGENT_ENABLED=false
PI_AGENT_PROVIDER=project-os-gateway
PI_AGENT_MODEL_ID=gpt-4o-mini
PI_AGENT_MODEL_NAME=Project OS Agent
PI_AGENT_BASE_URL=https://api.openai.com/v1
PI_AGENT_API_KEY=
PI_AGENT_MAX_TOKENS=1200
PI_AGENT_TIMEOUT_MS=15000
