FRONTEND_ORIGIN=http://127.0.0.1:5173
DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
COOKIE_SECURE=false
ALLOW_DEV_MEMBER_HEADER=true
SESSION_COOKIE_NAME=project_os_session
SESSION_TTL_SECONDS=2592000
VITE_MEMBER_ID=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_ORGANIZATION_ID=
DINGTALK_REDIRECT_URI=http://127.0.0.1:8787/api/v1/auth/dingtalk/callback
DINGTALK_SCOPE=openid
DINGTALK_AUTHORIZATION_URL=https://login.dingtalk.com/oauth2/auth
