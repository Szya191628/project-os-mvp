DINGTALK_USER_INFO_URL=https://api.dingtalk.com/v1.0/contact/users/me
DINGTALK_USER_DETAILS_URL=https://oapi.dingtalk.com/topapi/v2/user/get
DINGTALK_DEPARTMENT_DETAILS_URL=https://oapi.dingtalk.com/topapi/v2/department/get
DINGTALK_DEPARTMENT_LIST_IDS_URL=https://oapi.dingtalk.com/topapi/v2/department/listsubid
DINGTALK_DEPARTMENT_USERS_URL=https://oapi.dingtalk.com/topapi/v2/user/list
